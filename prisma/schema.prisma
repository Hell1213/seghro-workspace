// ============================================================
// Seghro - AI Agent Observability Dashboard
// ============================================================
// Current: SQLite (for development/sandbox)
// Production: Change provider to "postgresql" and update DATABASE_URL
// Example PostgreSQL URL: postgresql://user:password@localhost:5432/seghro
// After switching: bun run db:push (or db:migrate for production)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String       @default("viewer")
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id])
  apiKeys       ApiKey[]
  passwordResets PasswordReset[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId])
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  plan             String   @default("starter")
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  users            User[]
}

model Agent {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  framework   String?
  orgId       String?
  lastRunAt   DateTime?
  totalRuns   Int      @default(0)
  errorRate   Float    @default(0)
  avgLatency  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  traces      Trace[]
  issues      Issue[]
  alerts      Alert[]

  @@index([orgId])
}

model Trace {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  traceId      String
  status       String   @default("success")
  duration     Float
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  metadata     String?
  createdAt    DateTime @default(now())
  spans        Span[]

  @@index([agentId])
  @@index([traceId])
}

model Span {
  id           String   @id @default(cuid())
  traceId      String
  trace        Trace    @relation(fields: [traceId], references: [id])
  name         String
  type         String?
  status       String   @default("success")
  duration     Float
  startTime    Float
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  model        String?
  tool         String?
  children     String?
  createdAt    DateTime @default(now())

  @@index([traceId])
}

model Issue {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  title        String
  description  String?
  severity     String   @default("P1")
  status       String   @default("open")
  affectedRuns Int      @default(0)
  totalRuns    Int      @default(0)
  failureRate  Float    @default(0)
  rootCause    String?
  suggestedFix String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId])
}

model Alert {
  id        String   @id @default(cuid())
  issueId   String?
  agentId   String?
  agent     Agent?  @relation(fields: [agentId], references: [id])
  channel   String   @default("slack")
  title     String
  message   String?
  severity  String   @default("warning")
  status    String   @default("unread")
  createdAt DateTime @default(now())

  @@index([agentId])
}

model Metric {
  id        String   @id @default(cuid())
  agentId   String?
  name      String
  value     Float
  timestamp DateTime @default(now())
  labels    String?

  @@index([agentId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model Webhook {
  id         String    @id @default(cuid())
  orgId      String?
  url        String
  events     String    // JSON array of event types
  secret     String?
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId])
}

model MonitoredEndpoint {
  id             String   @id @default(cuid())
  name           String
  baseUrl        String
  status         String   @default("healthy")
  responseTime   Float    @default(0)
  errorRate      Float    @default(0)
  lastChecked    DateTime @default(now())
  circuitBreaker String   @default("closed")
  category       String   @default("llm")
  orgId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
}

model HealingAction {
  id           String   @id @default(cuid())
  type         String
  endpointName String
  action       String
  result       String
  severity     String   @default("info")
  reasoning    String?
  steps        String
  timestamp    DateTime @default(now())
  orgId        String?
  createdAt    DateTime @default(now())

  @@index([orgId])
}

model VerificationToken {
  id           String   @id @default(cuid())
  identifier   String   // email address
  token        String   @unique
  type         String   // 'email-verification' or 'password-reset'
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([identifier, type])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
